# Bright Data API Key
# Get from: https://brightdata.com/cp/setting
BRIGHTDATA_API_KEY=your_brightdata_api_key_here

# Groq API Key (for LLM-based DOM diff diagnosis)
# Get from: https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# Orchestrator settings
PORT=3001
CRON_SCHEDULE="*/15 * * * *"
REALTIME_MODE=false

# Dashboard (Vite proxy will handle WebSocket)
VITE_WS_URL=http://localhost:3001
